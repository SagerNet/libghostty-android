+    var loading: LoadingImage = loading: {
+        if (storage.loading) |loading_ptr| {
+            // Kitty clients send continuation chunks with only the m (and q)
+            // keys; a command carrying its own dimensions or a different
+            // id/number is a new transmission, meaning the in-progress
+            // chunked one was interrupted and can never complete. Drop it so
