+/// C: GhosttyKittyGraphicsVirtualPlacementIterator
+pub const VirtualPlacementIterator = if (build_options.kitty_graphics)
+    ?*VirtualPlacementIteratorWrapper
+else
+    ?*anyopaque;
+
+const VirtualPlacementIteratorWrapper = if (build_options.kitty_graphics)
+    struct {
+        alloc: std.mem.Allocator,
+        inner: ?kitty_unicode.PlacementIterator = null,
+        current: ?kitty_unicode.Placement = null,
+    }
+else
+    void;
+
+/// C: GhosttyKittyGraphicsVirtualRenderInfo
+pub const VirtualRenderInfo = extern struct {
+    size: usize = @sizeOf(VirtualRenderInfo),
+    image_id: u32 = 0,
+    placement_id: u32 = 0,
+    viewport_col: i32 = 0,
+    viewport_row: i32 = 0,
+    offset_x: u32 = 0,
+    offset_y: u32 = 0,
+    dest_width: u32 = 0,
+    dest_height: u32 = 0,
+    source_x: u32 = 0,
+    source_y: u32 = 0,
+    source_width: u32 = 0,
+    source_height: u32 = 0,
+};
+
+pub fn virtual_placement_iterator_new(
+    alloc_: ?*const CAllocator,
+    out: *VirtualPlacementIterator,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) {
+        out.* = null;
+        return .no_value;
+    }
+    const alloc = lib.alloc.default(alloc_);
+    const ptr = alloc.create(VirtualPlacementIteratorWrapper) catch {
+        out.* = null;
+        return .out_of_memory;
+    };
+    ptr.* = .{ .alloc = alloc };
+    out.* = ptr;
+    return .success;
+}
+
+pub fn virtual_placement_iterator_free(
+    iter_: VirtualPlacementIterator,
+) callconv(lib.calling_conv) void {
+    if (comptime !build_options.kitty_graphics) return;
+    const iter = iter_ orelse return;
+    iter.alloc.destroy(iter);
+}
+
+/// Reset the iterator to walk the unicode placeholder (virtual placement)
+/// runs within the terminal's current viewport.
+pub fn virtual_placement_iterator_begin(
+    terminal_: terminal_c.Terminal,
+    iter_: VirtualPlacementIterator,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const iter = iter_ orelse return .invalid_value;
+    iter.current = null;
+    const t = wrapper.terminal;
+    const pages = &t.screens.active.pages;
+    const bottom_right = pages.getBottomRight(.viewport) orelse {
+        iter.inner = null;
+        return .success;
+    };
+    iter.inner = kitty_unicode.placementIterator(
+        pages.getTopLeft(.viewport),
+        bottom_right,
+    );
+    return .success;
+}
+
+pub fn virtual_placement_iterator_next(
+    iter_: VirtualPlacementIterator,
+) callconv(lib.calling_conv) bool {
+    if (comptime !build_options.kitty_graphics) return false;
+    const iter = iter_ orelse return false;
+    if (iter.inner) |*inner| {
+        iter.current = inner.next();
+        if (iter.current != null) return true;
+        iter.inner = null;
+    }
+    return false;
+}
+
+/// Resolve the current virtual placement run into render geometry. The
+/// viewport position addresses the run's first placeholder cell; source and
+/// destination rectangles follow the same convention as
+/// ghostty_kitty_graphics_placement_render_info.
+pub fn virtual_placement_render_info(
+    iter_: VirtualPlacementIterator,
+    terminal_: terminal_c.Terminal,
+    out_: ?*VirtualRenderInfo,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const iter = iter_ orelse return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    if (out.size < @sizeOf(VirtualRenderInfo)) return .invalid_value;
+    const p = if (iter.current) |*current| current else return .invalid_value;
+
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const image = storage.imageById(p.image_id) orelse return .no_value;
+    if (t.cols == 0 or t.rows == 0) return .no_value;
+    const cell_width: u32 = t.width_px / @as(u32, @intCast(t.cols));
+    const cell_height: u32 = t.height_px / @as(u32, @intCast(t.rows));
+    if (cell_width == 0 or cell_height == 0) return .no_value;
+
+    const rp = p.renderPlacement(storage, &image, cell_width, cell_height) catch
+        return .no_value;
+    if (rp.dest_width == 0 or rp.dest_height == 0 or
+        rp.source_width == 0 or rp.source_height == 0)
+    {
+        return .no_value;
+    }
+
+    const pages = &t.screens.active.pages;
+    const pin_screen = pages.pointFromPin(.screen, rp.top_left) orelse
+        return .no_value;
+    const vp_screen = pages.pointFromPin(.screen, pages.getTopLeft(.viewport)) orelse
+        return .no_value;
+
+    out.image_id = p.image_id;
+    out.placement_id = p.placement_id;
+    out.viewport_col = @intCast(pin_screen.screen.x);
+    out.viewport_row = @as(i32, @intCast(pin_screen.screen.y)) -
+        @as(i32, @intCast(vp_screen.screen.y));
+    out.offset_x = rp.offset_x;
+    out.offset_y = rp.offset_y;
+    out.dest_width = rp.dest_width;
+    out.dest_height = rp.dest_height;
+    out.source_x = rp.source_x;
+    out.source_y = rp.source_y;
+    out.source_width = rp.source_width;
+    out.source_height = rp.source_height;
+    return .success;
+}
