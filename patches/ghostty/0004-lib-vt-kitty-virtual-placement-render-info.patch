+/**
+ * Rendering geometry for a virtual (unicode placeholder) placement run.
+ *
+ * Produced by ghostty_kitty_graphics_virtual_placement_render_info() for
+ * the run the iterator is positioned on. The viewport position addresses
+ * the run's first placeholder cell; the offsets are pixels from that
+ * cell's top-left corner. Source and destination rectangles follow the
+ * same convention as GhosttyKittyGraphicsPlacementRenderInfo.
+ *
+ * This struct uses the sized-struct ABI pattern. Initialize with
+ * GHOSTTY_INIT_SIZED(GhosttyKittyGraphicsVirtualRenderInfo) before calling
+ * ghostty_kitty_graphics_virtual_placement_render_info().
+ *
+ * @ingroup kitty_graphics
+ */
+typedef struct {
+  /** Size of this struct in bytes. Must be set to sizeof(GhosttyKittyGraphicsVirtualRenderInfo). */
+  size_t size;
+  /** Image ID encoded in the placeholder cells. */
+  uint32_t image_id;
+  /** Placement ID encoded in the placeholder cells, or 0. */
+  uint32_t placement_id;
+  /** Viewport-relative column of the run's first placeholder cell. */
+  int32_t viewport_col;
+  /** Viewport-relative row of the run's first placeholder cell. */
+  int32_t viewport_row;
+  /** Horizontal pixel offset from the origin cell's top-left corner. */
+  uint32_t offset_x;
+  /** Vertical pixel offset from the origin cell's top-left corner. */
+  uint32_t offset_y;
+  /** Destination width in pixels. */
+  uint32_t dest_width;
+  /** Destination height in pixels. */
+  uint32_t dest_height;
+  /** Source rectangle x origin in pixels. */
+  uint32_t source_x;
+  /** Source rectangle y origin in pixels. */
+  uint32_t source_y;
+  /** Source rectangle width in pixels. */
+  uint32_t source_width;
+  /** Source rectangle height in pixels. */
+  uint32_t source_height;
+} GhosttyKittyGraphicsVirtualRenderInfo;
