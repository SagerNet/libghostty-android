+/// Resolve the OSC 8 hyperlink URI at a viewport coordinate of the render
+/// state. The render state must be freshly updated: the returned string
+/// borrows page memory and is valid only until the next mutating terminal
+/// call.
+pub fn link_uri_at(
+    state_: RenderState,
+    x: u16,
+    y: u32,
+    out_: ?*lib.String,
+) callconv(lib.calling_conv) Result {
+    const wrapper = state_ orelse return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    const state = &wrapper.state;
+
+    const row_slice = state.row_data.slice();
+    const row_pins = row_slice.items(.pin);
+    if (x >= state.cols or y >= row_pins.len) return .no_value;
+
+    const link_pin = row_pins[y];
+    const link_page: *page.Page = link_pin.node.page();
+    const rac = link_page.getRowAndCell(x, link_pin.y);
+    if (!rac.cell.hyperlink) return .no_value;
+    const link_id = link_page.lookupHyperlink(rac.cell) orelse return .no_value;
+    const link = link_page.hyperlink_set.get(link_page.memory, link_id);
+    const uri = link.uri.offset.ptr(link_page.memory)[0..link.uri.len];
+    out.* = .{ .ptr = uri.ptr, .len = uri.len };
+    return .success;
+}
